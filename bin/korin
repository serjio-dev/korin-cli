#!/usr/bin/env php
<?php

declare(strict_types=1);

use Korin\Gedcom\Cli\Application;

// Installed as a dependency, the autoloader is that of the project; cloned, our own.
foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

exit((new Application())->run());
